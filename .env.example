# Copia este archivo a .env y ajusta los valores.
# .env NO se versiona: es donde viven las credenciales reales de tu entorno.

# ===== Base de datos =====
DB_NAME=developteca_db
DB_USERNAME=developteca
DB_PASSWORD=cambia-esta-contrasena

# ===== Backend =====
# Mínimo 256 bits (32+ caracteres) porque se firma con HMAC-SHA256.
# Genera uno con: openssl rand -base64 48
JWT_SECRET=genera-tu-propio-secreto-no-uses-este
JWT_EXPIRATION=86400000
